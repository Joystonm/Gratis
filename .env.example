# Gratis — Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================
# Cloudinary (optional — enables cloud uploads + AI features)
# ============================================================

# Your Cloudinary cloud name (found in Cloudinary dashboard)
VITE_CLOUDINARY_CLOUD_NAME=

# An unsigned upload preset (create one in Cloudinary Settings → Upload)
# IMPORTANT: Must be UNSIGNED — do NOT put your API Secret here
VITE_CLOUDINARY_UPLOAD_PRESET=

# ============================================================
# Notes
# ============================================================
# - Gratis works without Cloudinary. Images will be stored as local object URLs.
# - With Cloudinary configured: uploads go to cloud, AI features (background removal,
#   enhancement, upscaling) become available via Cloudinary transformations.
# - NEVER add CLOUDINARY_API_SECRET to this file. It would expose your credentials.
# - This file is safe to commit (no secrets). Your .env file should be in .gitignore.
